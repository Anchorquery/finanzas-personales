# ─── Directus ──────────────────────────────────────────────
# Generate strong values: openssl rand -hex 32
KEY=replace_with_random_32_byte_hex
SECRET=replace_with_random_32_byte_hex
ADMIN_EMAIL=admin@finanzas.local
ADMIN_PASSWORD=replace_with_strong_password
PORT=8055
PUBLIC_URL=http://localhost:8055
LOG_LEVEL=info

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ─── PostgreSQL ────────────────────────────────────────────
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=replace_with_strong_password

# ─── App mobile (build-time) ───────────────────────────────
# Gemini API key is stored in Directus org settings, not here.
#
# Sentry crash reporting (optional, mobile build):
#   flutter run --dart-define=SENTRY_DSN=https://...@sentry.io/... \
#               --dart-define=SENTRY_ENV=production
# If SENTRY_DSN is empty, Sentry is disabled (no-op).
