root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,kt,java}]
indent_size = 2
max_line_length = 100

[*.{py,sql}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,ps1}]
end_of_line = crlf
